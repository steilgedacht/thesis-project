// LesionINR Model Flow
digraph LesionINR {
	rankdir=TB size="10,10"
	coords [label="Spatial Coords (x)
[B, 3]" fillcolor="#E1F5FE" shape=box style=filled]
	time [label="Raw Time (t)
[B, 1]" fillcolor="#E1F5FE" shape=box style=filled]
	patient [label="Patient ID
[B, 1]" fillcolor="#E1F5FE" shape=box style=filled]
	time_enc [label="TimeEncoder
[B, 2*time_freqs]" fillcolor="#E8F5E9" shape=box style=filled]
	embed [label="nn.Embedding
[B, latent_dim]" fillcolor="#FFF3E0" shape=box style=filled]
	adapt [label="latent_adapt (MLP)
[B, latent_dim]" fillcolor="#FFF3E0" shape=box style=filled]
	siren_first [label="First SirenLayer
(omega_0=45)" fillcolor="#FFEBEE" shape=box style=filled]
	siren_mid [label="SirenLayers x N
(omega_0=30)" fillcolor="#FFEBEE" shape=box style=filled]
	out [label="Final Linear Layer
[B, output_dim]" fillcolor="#F3E5F5" shape=box style=filled]
	time -> time_enc
	patient -> embed
	time_enc -> adapt
	embed -> adapt
	coords -> siren_first
	adapt -> siren_first [label="z modulation"]
	adapt -> siren_mid [label="z modulation"]
	siren_first -> siren_mid
	siren_mid -> out
}
